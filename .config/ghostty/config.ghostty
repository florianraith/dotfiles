# Follow macOS appearance
theme = light:iTerm2 Light Background,dark:iTerm2 Dark Background

# Disable font ligatures
font-feature = -calt
font-feature = -liga
font-feature = -dlig

font-family = MesloLGS NF

# Install terminfo on SSH hosts, fall back to xterm-256color
shell-integration-features = ssh-terminfo,ssh-env,no-cursor

# Titlebar style (native, transparent, tabs, hidden)
macos-titlebar-style = tabs

# Cursor
cursor-style = block
